{
  "name": "nextguard",
  "version": "1.0.0",
  "description": "Production-ready Web Application Firewall (WAF) for Next.js and Node.js. Protects against DDoS, DoS, SQL Injection, XSS, Path Traversal, Command Injection, NoSQL Injection, SSRF, Prototype Pollution, and Malicious Bots.",
  "author": "NextGuard Team",
  "license": "MIT",
  "homepage": "https://github.com/NixxelTzy/NextGuard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NixxelTzy/NextGuard.git"
  },
  "bugs": {
    "url": "https://github.com/NixxelTzy/NextGuard/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/middleware/nextjs.d.ts",
      "import": "./dist/middleware/nextjs.mjs",
      "require": "./dist/middleware/nextjs.js"
    },
    "./express": {
      "types": "./dist/middleware/express.d.ts",
      "import": "./dist/middleware/express.mjs",
      "require": "./dist/middleware/express.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "nextjs",
    "nodejs",
    "firewall",
    "waf",
    "security",
    "ddos",
    "dos",
    "rate-limit",
    "sql-injection",
    "xss",
    "nosql-injection",
    "ssrf",
    "prototype-pollution",
    "honeypot",
    "7-layer-defense",
    "anti-ddos",
    "express",
    "middleware",
    "telegram-alerts",
    "threat-intelligence"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

